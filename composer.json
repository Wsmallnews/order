{
    "name": "wsmallnews/order",
    "description": "Wsmallnews system order modules",
    "keywords": [
        "Wsmallnews",
        "laravel",
        "order",
        "filament",
        "php"
    ],
    "homepage": "https://github.com/wsmallnews/order",
    "support": {
        "issues": "https://github.com/wsmallnews/order/issues",
        "source": "https://github.com/wsmallnews/order"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "smallnews",
            "email": "1371606921@qq.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "wsmallnews/product": "^1.0",
        "wsmallnews/support": "^1.0",
        "wsmallnews/user": "^1.0"
    },
    "suggest": {
        "wsmallnews/pay": "支付记录关联（sn-order.models.pay_record）需要 pay 包提供 PayRecord 模型"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.0 || ^8.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0",
        "pestphp/pest-plugin-arch": "^2.0 || ^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^2.0 || ^3.0 || ^4.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Wsmallnews\\Order\\": "src/",
            "Wsmallnews\\Order\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wsmallnews\\Order\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wsmallnews\\Order\\OrderServiceProvider"
            ],
            "aliases": {
                "Order": "Wsmallnews\\Order\\Facades\\Order"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
